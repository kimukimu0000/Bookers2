<table class="table">
  <thead>
    <tr>
      <th>image</th>
      <th>name</th>
      <th>follows</th>
      <th>followers</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% users.each do |user| %>
      <tr>
        <td>
          <%= link_to user_path(user) do %>
            <% if user.profile_image.attached? %>
              <%= image_tag user.profile_image, size: "80x80" %>
            <% else %>
              <%= image_tag "no_image.jpg", size: "80x80" %>
            <% end %>
          <% end %>
        </td>

        <td>
          <%= link_to user.name, user_path(user) %>
        </td>

        <td>
          <%= link_to user.followings.count,
                      user_followings_path(user) %>
        </td>

        <td>
          <%= link_to user.followers.count,
                      user_followers_path(user) %>
        </td>

        <td>
          <%= render "relationships/button", user: user %>
        </td>

        <td>
          <%= link_to "Show", user_path(user) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>