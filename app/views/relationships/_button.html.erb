<% unless user == Current.user %>
  <% if Current.user.following?(user) %>
    <%= link_to "Unfollow",
                user_relationships_path(user),
                data: { turbo_method: :delete },
                class: "btn btn-info" %>
  <% else %>
    <%= link_to "Follow",
                user_relationships_path(user),
                data: { turbo_method: :post },
                class: "btn btn-success" %>
  <% end %>
<% end %>
