<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bookers2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <header>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
<%= link_to root_path, class: "navbar-brand" do %>
  <i class="fa-solid fa-book"></i> Bookers
<% end %>

      <ul class="navbar-nav ms-auto">
        <% if authenticated? %>
          <li class="nav-item">
    <%= link_to user_path(Current.user), class: "nav-link text-light" do %>
  <i class="fa-solid fa-house fa-home"></i> Home
<% end %>

          </li>
          <li class="nav-item">
<%= link_to users_path, class: "nav-link text-light" do %>
  <i class="fa-solid fa-users"></i> Users
<% end %>

          </li>
          <li class="nav-item">
<%= link_to books_path, class: "nav-link text-light" do %>
  <i class="fa-solid fa-book-open"></i> Books
<% end %>

          </li>
          <li class="nav-item">
<%= link_to session_path,
            data: { turbo_method: :delete },
            class: "nav-link text-light" do %>
  <i class="fa-solid fa-right-from-bracket fa-sign-out-alt"></i> Log out
<% end %>

          </li>
        <% else %>
          <li class="nav-item">
         <%= link_to root_path, class: "nav-link text-light" do %>
  <i class="fa-solid fa-house fa-home"></i> Home
<% end %>

          </li>
          <li class="nav-item">
   <%= link_to about_path, class: "nav-link text-light" do %>
  <i class="fa-solid fa-link"></i> About
<% end %>

          </li>
          <li class="nav-item">
<%= link_to new_user_registration_path, class: "nav-link text-light" do %>
  <i class="fa-solid fa-user-plus"></i> Sign up
<% end %>

          </li>
          <li class="nav-item">
  <%= link_to new_session_path, class: "nav-link text-light" do %>
  <i class="fa-solid fa-right-to-bracket fa-sign-in-alt"></i> Log in
<% end %>

          </li>
        <% end %>
      </ul>
    </div>
  </nav>
</header>


<div class="container mt-3">
  <% flash.each do |type, message| %>
    <% color = type.to_s == "notice" ? "alert-success" : "alert-danger" %>
    <div class="alert <%= color %>"><%= message %></div>
  <% end %>


    <%= yield %>

    <footer class="mt-5">
  <div class="container">
    <p class="text-center">CopyRight Infratop.inc</p>
  </div>
</footer>


      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
          crossorigin="anonymous"></script>
  </body>
</html>
