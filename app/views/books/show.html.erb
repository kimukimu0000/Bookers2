<div class="container">
  <div class="row">


    <%= render "books/sidebar", user: @user, book: @new_book %>

  

    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>

      <table class="table">
        <tbody>
          <tr>
            <td>
              <%= link_to user_path(@user) do %>
                <% if @user.profile_image.attached? %>
                  <%= image_tag @user.profile_image, size: "80x80" %>
                <% else %>
                  <%= image_tag "no_image.jpg", size: "80x80" %>
                <% end %>
                <br>
                <%= @user.name %>
              <% end %>
            </td>

            <td>
              <%= link_to @book.title, book_path(@book) %>
            </td>

            <td><%= @book.body %></td>

            <% if @book.user == Current.user %>
              <td>
                <%= link_to "Edit", edit_book_path(@book),
                      class: "btn btn-success" %>
              </td>
              <td>
                <%= link_to "Destroy", book_path(@book),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Are you sure?"
                      },
                      class: "btn btn-danger" %>
              </td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>