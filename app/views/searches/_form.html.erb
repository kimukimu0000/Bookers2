<div class="container my-3">
  <%= form_with url: search_path,
                method: :get,
                local: true,
                class: "d-flex justify-content-center gap-2" do |f| %>

    <%= f.text_field :word,
                     value: params[:word],
                     placeholder: "Search..." %>

    <%= f.select :range,
                 options_for_select(
                   [["User", "User"], ["Book", "Book"]],
                   params[:range]
                 ) %>

    <%= f.select :search,
                 options_for_select(
                   [
                     ["完全一致", "perfect_match"],
                     ["前方一致", "forward_match"],
                     ["後方一致", "backward_match"],
                     ["部分一致", "partial_match"]
                   ],
                   params[:search]
                 ) %>

    <%= f.submit "検索", class: "btn btn-primary" %>
  <% end %>
</div>