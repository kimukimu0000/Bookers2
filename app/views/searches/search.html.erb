<div class="container">
  <% if @range == "User" %>
    <h2>Users search for "<%= @word %>"</h2>

    <%= render "relationships/users", users: @users %>
  <% else %>
    <h2>Books search for "<%= @word %>"</h2>

    <table class="table">
      <thead>
        <tr>
          <th></th>
          <th>Title</th>
          <th>Opinion</th>
        </tr>
      </thead>

      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td>
              <%= link_to user_path(book.user) do %>
                <% if book.user.profile_image.attached? %>
                  <%= image_tag book.user.profile_image, size: "80x80" %>
                <% else %>
                  <%= image_tag "no_image.jpg", size: "80x80" %>
                <% end %>
              <% end %>
            </td>

            <td>
              <%= link_to book.title, book_path(book) %>
            </td>

            <td>
              <%= book.body %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>