<%= turbo_frame_tag dom_id(book, :comments) do %>
  <p>Comments: <%= book.book_comments.count %></p>

  <% book.book_comments.each do |book_comment| %>
    <div>
      <%= link_to book_comment.user.name, user_path(book_comment.user) %>
      <%= book_comment.comment %>

      <% if book_comment.user == Current.user %>
        <%= link_to "Destroy",
                    book_book_comment_path(book, book_comment),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure?"
                    } %>
      <% end %>
    </div>
  <% end %>
<% end %>